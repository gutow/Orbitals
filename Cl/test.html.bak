		['isosurface neg1; color isosurface yellow; isosurface pos1; color isosurface green;',"green/yellow"],
		['isosurface neg1; color isosurface cyan; isosurface pos1; color isosurface purple;',"purple/cyan"],
		['isosurface neg1; color isosurface pink; isosurface pos1; color isosurface brown;',"brown/pink"]
		]);
		</script>
