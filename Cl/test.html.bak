Type:<br>
              </td>
              <td
 style="vertical-align: top; text-align: left; white-space: nowrap;">
              <script>
		jmolRadioGroup([['isosurface neg1 fill nomesh nodots; isosurface pos1 fill nomesh nodots;','Solid','true'],
		['isosurface neg1 mesh nofill nodots; isosurface pos1 mesh nofill nodots;', 'Mesh'],
		['isosurface neg1 dots nomesh nofill; isosurface pos1 dots nomesh nofill;', 'Dot']
		 ]);
		</script><br>
