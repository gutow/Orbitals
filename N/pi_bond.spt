  set labelOffset 4 4;
  set labelAlignment left;
  set labelPointer off;
  font label 13 SansSerif Plain;

end function;

function _setModelState();

  select ({0 1 6 7 12 13 18 19 24 25 30 31 36 37 42 43 48 49 54 55});
  Spacefill 0.39;
  select ({2:5 8:11 14:17 20:23 26:29 32:35 38:41 44:47 50:53 56:59});
  Spacefill 0.24;
  select BONDS ({4});
  bondOrder double;
  select BONDS ({0:3 5:49});
  wireframe 0.15;
  select BONDS ({4});
  wireframe 0.07;

  measures delete;
  set measures nanometers;
  font measures 15 SansSerif Plain;
  select measures ({null});

  frame 1.10;
  isosurface negpi -0.15 mo 8;# ({54 55}) ({null});
  isosurface negpi fill noMesh noDots notFrontOnly frontlit;
  color $negpi translucent 128 [xff0000];
  frame 1.10;
  isosurface pospi 0.15 mo 8; ;# ({54 55}) ({null});
  isosurface pospi fill noMesh noDots notFrontOnly frontlit;
  color $pospi translucent 128 [xff0000];

  lcaoCartoon color [x0000ff] [x0000ff];
  lcaoCartoon translucent 0.5;

  boundBox off;

end function;

function _setFrameState();
# frame state;
# modelCount 10;
# first 1.1;
# last 1.10;
  frame RANGE 1.1 1.10;
  animation DIRECTION +1;
  animation FPS 10;
  animation MODE ONCE 0.0 0.0;
  frame 1.10;
  animation OFF;
end function;

function _setPerspectiveState();
  set perspectiveModel 11;
  set scaleAngstromsPerInch 0.0;
  set perspectiveDepth true;
  set visualRange 5.0;
  set cameraDepth 3.0;
  boundbox corners {-1.2389905 -0.9440415 -7.253961E-5} {1.2389641 0.94387126 6.707999E-5} # volume = 6.531631E-4;
  center {-1.3232231E-5 -8.511543E-5 -2.7298047E-6};
  moveto 0.0 { -377 -822 -428 113.69} 100.0 0.0 0.2 {-1.3232231E-5 -8.511543E-5 -2.7298047E-6} 2.7576003 {0.0 0.0 0.0} 0.0011894647 0.099106885 50.0;;
  slab 100;depth 0;
  set spinX 0; set spinY 30; set spinZ 0; set spinFps 30; spin on;
end function;

function _setSelectionState();
  select ({0:59});
  set hideNotSelected false;
end function;

function _setState();
  initialize;
  set refreshing false;
  _setWindowState;
  _setFileState;
  _setVariableState;
  _setModelState;
  _setFrameState;
  _setPerspectiveState;
  _setSelectionState;
  set refreshing true;
  set antialiasDisplay false;
  set antialiasTranslucent true;
  set antialiasImages true;
  spin on;
end function;

_setState;
